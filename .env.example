# ── Job Search ──────────────────────────────────────────────────────────────
# RapidAPI key for JSearch (https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch)
RAPIDAPI_KEY=your_rapidapi_key_here

# ── AI ───────────────────────────────────────────────────────────────────────
# OpenAI API key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-proj-your_openai_key_here

# ── Recruiter Email Finder ───────────────────────────────────────────────────
# Hunter.io API key (https://hunter.io/api-keys)
HUNTER_API_KEY=your_hunter_api_key_here

# ── Email Sending ────────────────────────────────────────────────────────────
# Your Gmail address
EMAIL_ADDRESS=your_email@gmail.com
# Gmail App Password (not your account password)
# Generate at: https://myaccount.google.com/apppasswords
EMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ── LinkedIn Credentials (for Easy Apply automation) ────────────────────────
LINKEDIN_EMAIL=your_linkedin_email@gmail.com
LINKEDIN_PASSWORD=your_linkedin_password_here

# ── Indeed Credentials (optional) ────────────────────────────────────────────
INDEED_EMAIL=your_indeed_email@gmail.com
INDEED_PASSWORD=your_indeed_password_here
